# ─── Supabase ─────────────────────────────────────────────────────────────────
# Clés disponibles dans : Supabase Dashboard → Settings → API

# URL publique du projet Supabase (exposée côté client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anonyme (publique — lecture limitée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Clé de rôle service (SECRÈTE — ne jamais exposer côté client)
# Utilisée uniquement dans les routes API serveur (createAdminClient)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# Clé publiable Supabase (alias de l'anon key dans certaines configs)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...


# ─── Site ─────────────────────────────────────────────────────────────────────
# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://prevensia-formation.fr


# ─── Stripe (paiements en ligne) ──────────────────────────────────────────────
# Clés disponibles dans : Stripe Dashboard → Developers → API keys

# Clé secrète Stripe (SECRÈTE — serveur uniquement)
STRIPE_SECRET_KEY=sk_live_...

# Secret de validation des webhooks Stripe
# Stripe Dashboard → Developers → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...


# ─── Anthropic (bot IA Claude) ────────────────────────────────────────────────
# Clé disponible dans : console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...


# ─── Resend (e-mails transactionnels) ─────────────────────────────────────────
# Clé disponible dans : resend.com → API Keys
RESEND_API_KEY=re_...


# ─── Identité société (domiciliation, mentions légales, factures) ────────────
# Source unique de vérité : lib/config/company.ts. Utilisées dans les PDF
# (factures, devis, attestations), les mentions légales, le footer, le JSON-LD
# SEO et les emails transactionnels. Toutes optionnelles — valeurs par défaut
# = adresse actuelle de PREVENSIA FORMATION. Pour déménager : renseigner ces
# variables sur Vercel puis redéployer.
NEXT_PUBLIC_COMPANY_NAME=PREVENSIA FORMATION
NEXT_PUBLIC_COMPANY_LEGAL_NAME=PREVENSIA Groupe SAS
NEXT_PUBLIC_COMPANY_ADDRESS_LINE=33, avenue Philippe Auguste
NEXT_PUBLIC_COMPANY_POSTAL_CODE=75011
NEXT_PUBLIC_COMPANY_CITY=Paris
NEXT_PUBLIC_COMPANY_REGION=Île-de-France
NEXT_PUBLIC_COMPANY_COUNTRY=France
NEXT_PUBLIC_COMPANY_COUNTRY_CODE=FR
NEXT_PUBLIC_COMPANY_PHONE=01 89 62 94 92
NEXT_PUBLIC_COMPANY_EMAIL=contact@prevensia-formation.fr
NEXT_PUBLIC_COMPANY_LEGAL_FORM=SAS — Société par actions simplifiée
NEXT_PUBLIC_COMPANY_CAPITAL=500,00 €
NEXT_PUBLIC_COMPANY_SIREN=107 290 579
NEXT_PUBLIC_COMPANY_SIRET=107 290 579 00013
NEXT_PUBLIC_COMPANY_VAT=FR44107290579
NEXT_PUBLIC_COMPANY_RCS=107 290 579 R.C.S. Paris
NEXT_PUBLIC_COMPANY_NAF=85.59A
NEXT_PUBLIC_COMPANY_COLLECTIVE_AGREEMENT=Organismes de formation — IDCC 1516
NEXT_PUBLIC_COMPANY_DIRECTORS=Hachiba Said, Hachiba Karim


# ─── Développement local ──────────────────────────────────────────────────────
# En local, remplacer NEXT_PUBLIC_SITE_URL par :
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pour les tests Stripe en local, utiliser les clés test :
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... (généré par Stripe CLI : stripe listen)
